{
  "name": "md-cannon-assistant",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "MD助手：公开手牌与盖牌记录、联栗炮计算",
  "type": "module",
  "main": "dist/desktop/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-ui.mjs && node scripts/build-owned-reader.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "package:portable": "pnpm run build && node scripts/package-portable.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:all": "pnpm run build && pnpm test && pnpm run test:ui"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.7.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
